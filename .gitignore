# ============================================================
#  MobileIE-repro  .gitignore
#  公开仓库：只放我们自己写的代码、配置与文档。
#  别人的东西（数据集、作者发布代码、论文原文与插图）一律不入库。
# ============================================================

# ---------- 环境 / 工具 ----------
.venv/
.workbuddy-ai/
__pycache__/
*.py[cod]
.vscode/
.idea/

# ============================================================
#  一、数据集：约 16 GB / 约 10 万个文件
#  重新获取：repro/scripts/download_lolv1.py、download_uieb_zrr.py
# ============================================================
repro/data/

# ============================================================
#  二、第三方大体积二进制
#  （repro/third_party 里是一个 1.88 GB 的第三方 APK，
#    超过 GitHub 单文件 100 MB 硬上限，绝不能提交）
# ============================================================
repro/third_party/
cloud/dist/
deploy/wheels/
deploy/wheels.zip

# ============================================================
#  三、论文材料（IEEE/CVF 版权，未获再分发许可，故不入库）
#  论文原文与插图请从 ICCV 官方渠道获取。
#  注意：MobileIE-main/（作者的发布代码）**是要入库的** —— 它是 Apache-2.0，
#  可以合法随附，且没有它整个复现跑不起来（repro/setup.sh 会检查
#  MobileIE-main/MobileIE-main/model/utils.py 是否存在）。其 LICENSE 已一并保留。
# ============================================================
paper/**/*.png
paper/**/*.pdf
paper.txt
/*.pdf

# ============================================================
#  四、训练产物：只保留曲线与日志，不保留权重与验证预览图
#  （metrics.jsonl / train.log / config.yaml / train_summary.json 是要留的）
# ============================================================
repro/runs/**/ckpt/
repro/runs/**/images/
repro/results/*.html
repro/results/*.html.bak-*
repro/tmp/
repro/logs/
tmp/

# ============================================================
#  五、生成的网页 / PPT 产物
# ============================================================
output/

# ============================================================
#  六、来源不明的临时粘贴图片（仍在本地，未删除）
# ============================================================
/8dee0dc8722669fc8e32a71abee2801b.jpeg
/5dcbc98e51fbb285af7f5ebcfd1c29d2.jpg

# ============================================================
#  七、手动备份文件（本地保留，不入库——git 本身就是版本历史）
# ============================================================
*.bak
*.bak-*

# ============================================================
#  八、系统垃圾
# ============================================================
Thumbs.db
desktop.ini
